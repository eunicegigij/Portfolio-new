# Public site URL used for canonical links, sitemap, and Open Graph.
# Set this to the production origin before deploying. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Inbox for contact form messages.
CONTACT_EMAIL=eunice.gigij@gmail.com

# Optional. When RESEND_API_KEY is unset, the form stays usable and
# falls back to a mailto link. Never expose this key in client code.
RESEND_API_KEY=

# Verified sender for Resend, for example: Portfolio <hello@yourdomain.com>
RESEND_FROM=
